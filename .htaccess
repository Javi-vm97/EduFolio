# EduFolio - Enruta todas las peticiones hacia la carpeta public/
# (este archivo va en la raiz del sitio: htdocs/)
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # No reescribir lo que ya apunta a /public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
